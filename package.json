{
  "name": "cv-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CV as code: React template + JSON data -> ATS-friendly PDF, with automatic text checks.",
  "license": "MIT",
  "author": "Paweł Wykurz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwykurz/ai-cv-builder.git"
  },
  "bugs": {
    "url": "https://github.com/pwykurz/ai-cv-builder/issues"
  },
  "homepage": "https://github.com/pwykurz/ai-cv-builder#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cv",
    "resume",
    "pdf",
    "ats",
    "react",
    "json",
    "playwright"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pdf": "node scripts/render-pdf.mjs",
    "check": "node scripts/check-pdf.mjs",
    "cv": "node scripts/cv.mjs",
    "cv:all": "node scripts/cv.mjs --all"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
