{
  "name": "cv-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CV as code: React template + JSON data -> ATS-friendly PDF, with automatic text checks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pdf": "node scripts/render-pdf.mjs",
    "check": "node scripts/check-pdf.mjs",
    "cv": "node scripts/cv.mjs",
    "cv:all": "node scripts/cv.mjs --all"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3"
  }
}
